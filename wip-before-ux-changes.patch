@@ -0,0 +1,25 @@
+import "./History.scss";
+
+interface HistoryProps {}
+
+const History: React.FC<HistoryProps> = ({}) => {
+  let history: string[] =
+    JSON.parse(localStorage.getItem("countries")!) ?? Array<string>;
+
+  history.reverse();
+
+  const topPicks = history.slice(0, 4);
+
+  console.log("topPicks: ", topPicks);
+
+  return (
+    <div className="history-section">
+      <h1>Recently seen</h1>
+      {history.map((country: string, index: number) => (
+        <div key={index}>{country}</div>
+      ))}
+    </div>
+  );
+};
+
+export default History;
